# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Optional production canonical site URL (e.g. https://oceaneditorial.mv).
# When unset, defaults to APP_URL or safe development fallback.
NEXT_PUBLIC_SITE_URL="https://oceaneditorial.mv"

# CMS_API_URL: Optional headless CMS base endpoint (e.g. https://cms.oceaneditorial.mv/api).
# When provided, lib/content-service.ts activates the RemoteCmsAdapter with runtime validation.
CMS_API_URL=""

# CMS_API_TOKEN: Optional server-side Bearer authorization token for the headless CMS.
CMS_API_TOKEN=""

# CMS_REVALIDATE_SECONDS: Next.js Incremental Static Regeneration interval in seconds (10 to 86400).
CMS_REVALIDATE_SECONDS="60"

# CMS_ALLOW_DEMO_FALLBACK: Whether to fall back to demo content on CMS failure.
# Set to "false" in production to avoid presenting mock articles during outages.
CMS_ALLOW_DEMO_FALLBACK="false"

# DATABASE_URL: Managed PostgreSQL connection string (Cloud SQL, Supabase, Neon, AWS RDS).
# Example: postgresql://username:password@ep-sample-pool.neon.tech/ocean_editorial?sslmode=require
# Keep empty in staging/local development until an external database is provisioned.
DATABASE_URL=""

# DATABASE_SSL: Whether to require SSL connection to the managed PostgreSQL database (default: true).
DATABASE_SSL="true"

# DATABASE_REJECT_UNAUTHORIZED: Enforces TLS certificate verification.
# In production, certificate verification is strictly and unconditionally true.
# In local development only, setting this to "false" allows connecting with self-signed development certificates.
DATABASE_REJECT_UNAUTHORIZED="true"

# DATABASE_CA_CERT: Optional custom root CA certificate (PEM string) for private cloud databases or Google Cloud SQL.
DATABASE_CA_CERT=""

# DATABASE_MAX_CONNECTIONS: Database connection pool limit (default: 10, max bounded to 30 for serverless).
DATABASE_MAX_CONNECTIONS="10"

# AUTH_SECRET: Cryptographically secure secret (min 32 chars) for signing HTTP-only CMS session tokens.
# Required in production. Generate with: openssl rand -hex 32
# Known weak placeholders (e.g. "12345678901234567890123456789012") are strictly rejected in production.
AUTH_SECRET=""

# AUTH_PROVIDER_ISSUER_URL: OIDC / OAuth 2.0 / SSO Identity Provider issuer URL for production sign-in.
# Production CMS requires an enterprise identity provider (Google Workspace, Okta, Azure AD, Auth0).
# In production, email-only sign-in is disabled and fails-closed.
AUTH_PROVIDER_ISSUER_URL=""
AUTH_PROVIDER_CLIENT_ID=""
AUTH_PROVIDER_CLIENT_SECRET=""

# ALLOW_STAGING_AUTH_BYPASS: Controls whether quick test account selection is enabled in non-production environments.
# Defaults to true in development/staging. Set to "false" to enforce complete provider verification in staging.
ALLOW_STAGING_AUTH_BYPASS="true"

# TEST_DATABASE_URL: Opt-in isolated PostgreSQL database connection string for live repository tests.
# Must NOT contain "prod" in the host or database name. Leave unset to run static safety checks only.
TEST_DATABASE_URL=""

